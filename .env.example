# Public site URL, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://walkergoodhomes.co.uk

# --- Enquiry delivery -------------------------------------------------------
# Enquiries are always appended to LEADS_DIR as JSONL. Set these as well and
# each one is emailed too. Without them the lead is still captured on disk.
RESEND_API_KEY=
LEAD_FROM_EMAIL=enquiries@walkergoodhomes.co.uk
LEAD_TO_EMAIL=walkergoodhomesltd@gmail.com

# Where enquiry and site-visit records are appended. Must be writable and
# must persist — on a platform with an ephemeral filesystem, point this at a
# mounted volume or configure email delivery above.
LEADS_DIR=.data

# --- Reserved-buyer area ---------------------------------------------------
# Both must be set before /buyers will let anyone in; unset, it stays closed.
# BUYER_SESSION_SECRET needs at least 32 characters:
#   openssl rand -base64 48
BUYER_ACCESS_CODE=
BUYER_SESSION_SECRET=
